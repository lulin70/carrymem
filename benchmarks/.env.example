# CarryMem Benchmark API Configuration
# Copy this file to .env and fill in your API keys
# NEVER commit .env to git
#
# API routing:
#   Moka AI  -> Claude models (code/claude-sonnet-4-6)
#   Azemm    -> GPT models (gpt-4o)
# Do NOT send gpt-4o to Moka AI or Claude to Azemm.

# Answer generation API (Moka AI -> Claude)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.moka-ai.com/v1
LLM_MODEL=code/claude-sonnet-4-6

# Judge API (Azemm -> GPT-4o)
JUDGE_API_KEY=
JUDGE_BASE_URL=https://api.azemm.top/v1
JUDGE_MODEL=gpt-4o
