# CarryMem Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# === LLM API (optional, for semantic features) ===
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.moka-ai.com/v1
# LLM_MODEL=

# === Encryption (auto-generated if not set) ===
# CARRYMEM_ENCRYPTION_KEY=

# === Storage (default: ~/.carrymem) ===
# CARRYMEM_DATA_DIR=

# === Logging ===
# CARRYMEM_LOG_LEVEL=INFO

# === MCP Server (optional) ===
# CARRYMEMP_HOST=127.0.0.1
# CARRYMEMP_PORT=8765
