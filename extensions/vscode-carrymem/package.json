{
  "name": "vscode-carrymem",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.2.0",
  "publisher": "carrymem",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Machine Learning",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "AI",
    "LLM",
    "memory",
    "rules",
    "context"
  ],
  "activationEvents": [
    "onView:carrymem-rules"
  ],
  "main": "./out/src/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "carrymem",
          "title": "%viewContainer.title%",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "carrymem": [
        {
          "id": "carrymem-rules",
          "name": "%view.name%",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "carrymem.refreshRules",
        "title": "%command.refreshRules.title%",
        "icon": "$(refresh)"
      },
      {
        "command": "carrymem.addRule",
        "title": "%command.addRule.title%",
        "icon": "$(add)"
      },
      {
        "command": "carrymem.editRule",
        "title": "%command.editRule.title%",
        "icon": "$(edit)"
      },
      {
        "command": "carrymem.deleteRule",
        "title": "%command.deleteRule.title%",
        "icon": "$(trash)"
      },
      {
        "command": "carrymem.toggleRule",
        "title": "%command.toggleRule.title%",
        "icon": "$(eye)"
      },
      {
        "command": "carrymem.matchRules",
        "title": "%command.matchRules.title%"
      },
      {
        "command": "carrymem.showEffectivenessReport",
        "title": "%command.showEffectivenessReport.title%"
      },
      {
        "command": "carrymem.skillPack",
        "title": "%command.skillPack.title%"
      },
      {
        "command": "carrymem.skillInstall",
        "title": "%command.skillInstall.title%"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "carrymem.refreshRules",
          "when": "view == carrymem-rules",
          "group": "navigation"
        },
        {
          "command": "carrymem.addRule",
          "when": "view == carrymem-rules",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "carrymem.editRule",
          "when": "view == carrymem-rules && viewItem =~ /rule/",
          "group": "inline"
        },
        {
          "command": "carrymem.toggleRule",
          "when": "view == carrymem-rules && viewItem =~ /rule-active/",
          "group": "inline"
        },
        {
          "command": "carrymem.deleteRule",
          "when": "view == carrymem-rules && viewItem =~ /rule/",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "carrymem.dbPath": {
          "type": "string",
          "default": "",
          "description": "%configuration.dbPath.description%"
        },
        "carrymem.autoMatch": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.autoMatch.description%"
        },
        "carrymem.defaultScope": {
          "type": "string",
          "default": "personal",
          "enum": ["personal", "company", "negotiated"],
          "description": "%configuration.defaultScope.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && cp package.json out/ && cp test/runUnitTests.js out/test/ && cp test/runVscodeTests.js out/test/",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "test:unit": "node ./out/test/runUnitTests.js",
    "test:e2e": "node ./out/test/runVscodeTests.js",
    "test": "npm run test:unit && npm run test:e2e"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.4.0",
    "@vscode/test-cli": "^0.0.10",
    "@types/mocha": "^10.0.6",
    "mocha": "^10.2.0",
    "typescript": "^5.3.0"
  }
}
